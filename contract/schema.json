{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regles.data.gouv.fr/schemas/record.schema.json",
  "title": "Service (Règle)",
  "description": "Schéma d'une fiche de règle (service public) et de ses métadonnées de base. Un fichier de data/ contient exactement un objet décrit par ce schéma.",
  "version": "0.1.0",
  "x-unique-fields": ["id", "identifier"],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "URI canonique de la règle (ex: https://regles.data.gouv.fr/regles/cnaf/prime-activite)."
    },
    "identifier": {
      "type": "string",
      "description": "Identifiant unique de la règle (ex: solidarite.prime-activite.openfisca-france)."
    },
    "version": {
      "type": "string",
      "description": "Version semver de la règle (ex: 169.15.0)."
    },
    "title": {
      "type": "object",
      "description": "Titre multilingue. Exemple: {\"fr\": \"Prime d'activité\", \"en\": \"Activity Bonus\"}.",
      "properties": {
        "fr": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["fr"],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "description": "Description multilingue de la règle.",
      "properties": {
        "fr": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["fr"],
      "additionalProperties": false
    },
    "valid_from": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de début de validité (dct:valid)."
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de fin de validité (dct:valid)."
    },
    "subjects": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Tags thématiques (ex: ['prime-activite', 'minima-sociaux'])."
    },
    "source_repository": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "URL du dépôt source (dct:source, ex: https://github.com/openfisca/openfisca-france)."
    },
    "source_commit": {
      "type": ["string", "null"],
      "description": "SHA du commit épinglé (schema:SoftwareSourceCode)."
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de création de la fiche."
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date de dernière mise à jour."
    },
    "competent_authority": {
      "type": "string",
      "format": "uri",
      "description": "URI de l'organisation compétente (cv:hasCompetentAuthority)."
    }
  },
  "required": [
    "id",
    "identifier",
    "version",
    "title",
    "description",
    "valid_from",
    "valid_to",
    "subjects",
    "source_repository",
    "source_commit",
    "created_at",
    "updated_at",
    "competent_authority"
  ]
}
