        -- distance_km: 101
        --durée_minutes: 50
      }
      -- trajet_depuis_domicile_étudiant: Présent contenu Trajet {
        --distance_km: 10
        -- durée_minutes: 20
      }
      -- montant_matériel_spécifique : 0€
      -- étudiant_en_filière_post_bac: faux
    }
  assertion (calcul.critères_applicables = [C3_éloignement_agent contenu 4,0])
  assertion (calcul.nb_points = 4,0)
```


# Cas N°4 : logement separe, l'adresse des parents est moins avantageuse
```catala
#[test]
déclaration champ d'application TestCalculPointsAideScolarite4:
  résultat calcul contenu Aide_scolarite.CalculPointsAideScolarite

champ d'application TestCalculPointsAideScolarite4:
  définition calcul égal à
    résultat de Aide_scolarite.CalculPointsAideScolarite avec {
      -- valeur_point: 10€
      -- trajet_depuis_domicile_agent: Trajet {
        -- distance_km: 60 # trajet agent 2 points mais retire le C2
        -- durée_minutes: 50
      }
      -- trajet_depuis_domicile_étudiant: Présent contenu Trajet {
        -- distance_km: 32 # trajet etudiant 2 points
        -- durée_minutes: 20
      }
      -- montant_matériel_spécifique : 0€
      -- étudiant_en_filière_post_bac: faux
    }
  assertion (calcul.critères_applicables = [C2_domiciliation_séparée contenu 2,0; C3_éloignement_étudiant contenu 2,0])
  assertion (calcul.nb_points = 4,0)
```

