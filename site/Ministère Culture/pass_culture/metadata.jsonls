          "id": "https://github.com/openfisca/openfisca-france/blob/9b822b70c7c4c5197113799b54833b5753d13466/openfisca_france/parameters/prestations_sociales/education/pass_culture/montants.yaml"
        },
        {
          "id": "https://github.com/openfisca/openfisca-france/blob/9b822b70c7c4c5197113799b54833b5753d13466/openfisca_france/parameters/prestations_sociales/education/pass_culture/age_maximum.yaml"
        },
        {
          "id": "https://github.com/openfisca/openfisca-france#source-code"
        }
      ],
      "cv:hasInput": [
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "date_naissance",
          "cprmv:definition": "Date de naissance de l'individu. OpenFisca en dérive automatiquement la variable 'age' (en années, au premier jour du mois) — on peut alternativement fournir 'age' directement si la date exacte est inconnue.",
          "cprmv:type": "xsd:date",
          "schema:valueRequired": true,
          "title": "Date de naissance"
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "period",
          "cprmv:definition": "Mois pour lequel le montant est calculé (definition_period = MONTH). La formule lit en réalité l'âge au mois suivant la période demandée (period.offset(1, 'month')).",
          "cprmv:type": "xsd:gYearMonth",
          "schema:valueRequired": true,
          "title": "Période de calcul"
        }
      ],
      "cpsv:produces": {
        "type": [
          "cv:Output",
          "cprmv:Rule"
        ],
        "dct:identifier": "pass_culture",
        "cprmv:definition": "Montant mensuel crédité, en euros, déterminé par un barème par âge (15 à 18 ans) lu dans les paramètres de législation à la date de calcul — ce n'est pas un input utilisateur mais une donnée réglementaire versionnée dans le temps (ex. 150€ à 18 ans depuis le 2025-03-01, contre 300€ auparavant).",
        "cprmv:type": "xsd:decimal",
        "title": "Montant du Pass Culture"
      },
