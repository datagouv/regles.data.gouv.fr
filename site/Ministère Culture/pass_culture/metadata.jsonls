      "type": "cpsv:PublicService",
      "dct:identifier": "openfisca-france.pass_culture",
      "title": "Pass Culture — calcul du montant",
      "description": "Calcule le montant mensuel du Pass Culture crédité sur le compte d'un jeune, selon son âge. Variable OpenFisca-France, utilisée en production par des simulateurs officiels comme mesdroitssociaux.gouv.fr.",
      "dct:valid": "2019-02-01/",
      "cv:hasCompetentAuthority": {
